# Copy to .env.test at the project root and adjust for your test server.
#
# Used by the e2e suite only: web/playwright.config.js reads `.env.test` and
# injects it into the environment of the server under test. Same key set as
# .env.example, so it reads like one.
#
# Precedence: the parsed values are applied last when the server is spawned,
# so they beat both the developer's .env and any SERVER_URL/ENDPOINT already
# exported in the calling environment — which matters, because the app exports
# its own settings into os.environ on every save. Point the suite at a
# different file with `E2E_ENV_FILE=other.test npm run test:e2e` instead of
# editing .env.test.
#
# A key left commented out is exported as *empty*, i.e. deliberately cleared
# rather than inherited — so this file, and nothing ambient, decides what a
# spec talks to.
#
# `.env.test` is gitignored like `.env`: it names a machine-local server and may
# carry its key. Keep this template secret-free.

# Target LLM endpoint (the dedicated test server; not the run endpoint)
SERVER_URL=http://192.168.1.3:8080/v1
SERVER_URL_API_KEY=not-needed
ENDPOINT=qwen3.8-flash-next-iq3_xxs

# The test server reports text-only input modalities, so the Chat image attach
# button stays off — a spec can then assert on that consistently.
#SUPPORTS_VISION=1

# System prompt sent with every benchmark question and chat message
LLM_SYSPROMPT="You are a helpful assistant."

# Sampling: pinned so a spec asserting on an answer is reproducible.
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0
REPEAT_PENALTY=1.0
PRESENCE_PENALTY=0
# Thinking output is off: it dominates both latency and token counts, which
# makes the streamed-answer assertions below slow and variable.
REASONING=off
# Smallest available set (30 questions). A few-minute benchmark run is the
# slowest thing a spec can wait on, so a tiny fixture set would help here.
QUESTION_SET=legacy
#LLM_DEBUG=1

# Verifier agent: pointed at the same test server, so a graded answer is
# possible. Without a verifier an answer cannot be graded and is failed, which
# would make every benchmark spec measure the wrong thing.
VERIFIER_AGENT_SYSPROMPT="You are a response expert analyser. The user will provide a json file containing the following structure { \"question\": \"<the_question>\", \"response\": \"<the_llm_response>\", \"expected\": \"<the_expected_answer_from_questions_file>\" }. Your goal is to evaluate if the response matches the expected answer. The question is provided for clarity only and you must not answer it. You must not think of what could be the response but only use the **expected** attribute value witch is the expected response. Words can differ but the meaning of both (response, expected) must match. If you think there is a match just respond 'true'. If not just respond 'false'. Do not add any other output or comments. Very important: Your response output must only contain one word: 'true' or 'false'."
VERIFIER_AGENT_SERVERURL=http://192.168.1.3:8080/v1
VERIFIER_AGENT_SERVERURL_API_KEY=not-needed
VERIFIER_AGENT_ENDPOINT=qwen3.8-flash-next-iq3_xxs

# MCP connectors (Chat tab only). Kept off: a spec that does not ask for a
# connector must not spawn one. BENCHMARKIT_DISABLE_MCP/_LSP (set by the
# Playwright config) disable the hubs outright; these keys stay empty so the
# declaration files are not even consulted.
#MCP_ENABLED=
#LSP_ENABLED=
# Cap on tool-calling iterations per chat reply (default 25). Left at the
# default; lower it here if a spec needs a bounded tool loop.
#MAX_TOOL_ITERATION=25
