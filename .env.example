# Copy to .env at the project root and adjust for your platform.
# Real environment variables take precedence over the values defined here.

# Target LLM endpoint
SERVER_URL=http://127.0.0.1:8080/v1
SERVER_URL_API_KEY=not-needed
ENDPOINT=my-model

# Set to 1 when the model accepts image input (enables the Chat image attach
# button). The benchmark itself never sends images.
#SUPPORTS_VISION=1

# System prompt sent with every benchmark question and chat message
LLM_SYSPROMPT="You are a helpful assistant."

# Sampling parameters (optional)
#TEMPERATURE=0.2
#TOP_P=0.95
#TOP_K=20
#MIN_P=0
#REPEAT_PENALTY=1.0
#PRESENCE_PENALTY=0
#REASONING=off|low|medium|high|xhigh
#QUESTION_SET=legacy|78qcm

# LLM_DEBUG=1 makes the in-house LLM client log the payload of every request
# (URL, model, body) to the server console at DEBUG, so a failed call can be
# read off that console. The refused call's status and upstream body reach the
# UI's error line whether or not this is on; what the flag adds is the payload.
# Very verbose; switch it back off once the failure is diagnosed.
#LLM_DEBUG=1

# Verifier agent (optional)
VERIFIER_AGENT_SYSPROMPT="You are a response expert analyser. The user will provide a json file containing the following structure { \"question\": \"<the_question>\", \"response\": \"<the_llm_response>\", \"expected\": \"<the_expected_answer_from_questions_file>\" }. Your goal is to evaluate if the response matches the expected answer. The question is provided for clarity only and you must not answer it. You must not think of what could be the response but only use the **expected** attribute value witch is the expected response. Words can differ but the meaning of both (response, expected) must match. If you think there is a match just respond 'true'. If not just respond 'false'. Do not add any other output or comments. Very important: Your response output must only contain one word: 'true' or 'false'."
#VERIFIER_AGENT_SERVERURL=http://127.0.0.1:8080/v1
#VERIFIER_AGENT_SERVERURL_API_KEY=not-needed
#VERIFIER_AGENT_ENDPOINT=verifier-model

# MCP connectors (Chat tab only). Comma-separated connector ids to activate.
# Pair console_mcp with fedit_mcp: shell commands vs file reads/edits, e.g.
# MCP_ENABLED=console_mcp,fedit_mcp,playwright_mcp
#MCP_ENABLED=
# LSP_ENABLED=pyright,typescript,vue
#LSP_ENABLED=
# Max tool-calling iterations for a single chat reply (default: 25),
# shared by all connectors
#MAX_TOOL_ITERATION=25
# Absolute path to the python interpreter the stdio connectors run on (the
# console and fedit commands in .nojae/mcp-settings.json expand
# ${BENCHMARKIT_PYTHON_ROOT} from it as their first argument).
#BENCHMARKIT_PYTHON_ROOT=